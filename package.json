{
  "name": "campus-ride-share-matching",
  "version": "1.0.0",
  "description": "A platform where students post ride offers or requests with pickup/drop-off points and are matched based on route compatibility. The project implements geospatial query handling, matching heuristics, and notification via in-app messaging.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test:unit": "jest --detectOpenHandles",
    "test": "node test-ride-geospatial.js && node test-ride-search-integration.js",
    "test:geospatial": "node test-ride-search-integration.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pavithrabanvari/Campus-Ride-Share-Matching.git"
  },
  "keywords": [],
